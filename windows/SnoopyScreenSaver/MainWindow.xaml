<Window x:Class="SnoopyScreenSaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" Cursor="None"
        Loaded="Window_Loaded">
    <Grid>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
        <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" Stretch="Fill" />
    </Grid>
</Window>
